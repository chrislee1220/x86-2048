# Target 平台设置
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# 存储空间配置 - 扩容至 2GB
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# 文件系统支持
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 基础系统组件
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y

# LuCI Web 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-ssl-openssl=y

# 中文语言包
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# CPU 温度监控相关
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-thermal=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_collectd-mod-sensors=y
CONFIG_PACKAGE_collectd-mod-cpu=y

# eBPF 和 BTF 支持 - 为 daed 提供支持
CONFIG_KERNEL_BPF=y
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_HAVE_EBPF_JIT=y
CONFIG_KERNEL_EBPF_JIT=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_XDP_SOCKETS_DIAG=y

# BTF (BPF Type Format) 支持
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n

# Cgroups v2 支持 (daed 需要)
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_MEMCG_SWAP=y

# 网络相关的 eBPF 支持
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_NET_CLS_BPF=y
CONFIG_KERNEL_NET_ACT_BPF=y
CONFIG_KERNEL_NETFILTER_XT_MATCH_BPF=y

# BPF 文件系统
CONFIG_KERNEL_BPF_FS=y

# 其他内核特性
CONFIG_KERNEL_KPROBE_EVENTS=y
CONFIG_KERNEL_UPROBE_EVENTS=y
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_FUNCTION_TRACER=y
CONFIG_KERNEL_DYNAMIC_FTRACE=y

# 新增: daed 可能需要的额外内核配置
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_SOCK_CGROUP_DATA=y
CONFIG_KERNEL_BPF_PROG_TYPE_SOCK_OPS=y
CONFIG_KERNEL_BPF_PROG_TYPE_SK_MSG=y
CONFIG_KERNEL_NET_SCH_INGRESS=y
CONFIG_KERNEL_NET_CLS_ACT=y
CONFIG_KERNEL_NF_CONNTRACK=y
CONFIG_KERNEL_NF_CONNTRACK_MARK=y
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_SECCOMP_FILTER=y

# IPv6 支持
CONFIG_PACKAGE_ipv6helper=y
CONFIG_KERNEL_IPV6=y

# 常用工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

# USB 支持
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# 文件系统支持
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y

# 常用应用
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# 网络工具
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ethtool=y

# 性能相关
CONFIG_PACKAGE_irqbalance=y

# 编译选项（优化：关闭开发者模式以减小固件体积）
# CONFIG_DEVEL=y  # 如果不需要开发功能，注释掉这行
CONFIG_CCACHE=y
